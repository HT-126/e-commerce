# Used by docker-compose.yml. Copy to ".env" (next to docker-compose.yml) and change both values.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# MySQL root password (setup, import script, tests)
MYSQL_ROOT_PASSWORD=change-me-root

# Password of the limited "shop" user that the API uses
MYSQL_APP_PASSWORD=change-me-app
